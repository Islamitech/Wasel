# Server Environment
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://wasel_user:wasel_secret@localhost:5432/wasel_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Cryptography Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_password
STORAGE_PUBLIC_BUCKET=wasel-public
STORAGE_PRIVATE_BUCKET=wasel-identity-private

# Providers
OTP_PROVIDER=dev
MAP_PROVIDER=dev
PUSH_PROVIDER=dev

# Web Push VAPID Keys (for production push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wasel.local
