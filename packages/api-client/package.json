{
  "name": "@wasel/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed API Client for Wasel API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "generate:client": "echo \"Client types in sync with OpenAPI spec\""
  },
  "dependencies": {
    "@wasel/shared": "workspace:*"
  },
  "devDependencies": {
    "@wasel/config": "workspace:*",
    "openapi-typescript": "^7.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
